#!/usr/bin/env bash
set -euo pipefail
trap 'echo "ERROR: Scaffold failed. Remove ${ROOT_DIR:-<project-name>_root} manually." >&2; exit 1' ERR

# =============================================================================
# scaffold — Create project scaffolding with 31 branch worktrees
# =============================================================================
# Usage: scaffold <project-name>
# Output: <project-name>_root/ with .bare + 31 worktrees
# =============================================================================

# ---------------------------------------------------------------------------
# Phase 0 — Preflight
# ---------------------------------------------------------------------------

PROJECT_NAME=$(echo "${1:-}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

if [ -z "$PROJECT_NAME" ]; then
    echo "ERROR: No project name provided." >&2
    echo "Usage: scaffold <project-name>" >&2
    exit 1
fi

if ! echo "$PROJECT_NAME" | grep -qE '^[a-zA-Z0-9_-]+$'; then
    echo "ERROR: Invalid project name '$PROJECT_NAME'. Use alphanumeric, hyphens, underscores." >&2
    exit 1
fi

ROOT_DIR="${PROJECT_NAME}_root"

if [ -d "$ROOT_DIR/.bare" ]; then
    echo "ERROR: Project already scaffolded. '$ROOT_DIR/.bare' exists." >&2
    exit 1
fi

if ! command -v git &>/dev/null; then
    echo "ERROR: git is not installed or not in PATH." >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Create root + bare repo
# ---------------------------------------------------------------------------

mkdir "$ROOT_DIR"
git init --bare "$ROOT_DIR/.bare" >/dev/null
GIT="git --git-dir=$ROOT_DIR/.bare"

# ---------------------------------------------------------------------------
# Helper: create orphan worktree, write README, commit
# ---------------------------------------------------------------------------

create_orphan() {
    local branch="$1"
    local readme="${2:-}"
    local extra_files="${3:-}"  # space-separated list of files to create

    echo "Creating branch: $branch [orphan]"

    $GIT worktree add -b "$branch" --orphan "$ROOT_DIR/$branch" >/dev/null

    if [ -n "$readme" ]; then
        printf '%s\n' "$readme" > "$ROOT_DIR/$branch/README.md"
        git -C "$ROOT_DIR/$branch" add README.md 2>/dev/null || true
    fi

    if [ -n "$extra_files" ]; then
        for ef in $extra_files; do
            case "$ef" in
                *.md|*.yml|*.yaml|*.toml)
                    touch "$ROOT_DIR/$branch/$ef"
                    git -C "$ROOT_DIR/$branch" add "$ef" 2>/dev/null || true
                    ;;
                */)
                    mkdir -p "$ROOT_DIR/$branch/$ef"
                    touch "$ROOT_DIR/$branch/$ef/.gitkeep"
                    git -C "$ROOT_DIR/$branch" add "$ef" 2>/dev/null || true
                    ;;
                *)
                    touch "$ROOT_DIR/$branch/$ef"
                    git -C "$ROOT_DIR/$branch" add "$ef" 2>/dev/null || true
                    ;;
            esac
        done
    fi

    git -C "$ROOT_DIR/$branch" commit -m "chore: $branch — seed" >/dev/null 2>&1
}

# ---------------------------------------------------------------------------
# Helper: create fork worktree from existing parent branch
# ---------------------------------------------------------------------------

create_fork() {
    local branch="$1"
    local parent="$2"

    echo "Creating branch: $branch [fork of $parent]"

    $GIT branch "$branch" "$parent" >/dev/null
    $GIT worktree add "$ROOT_DIR/$branch" "$branch" >/dev/null
}

# =============================================================================
# Phase 1 — Utility Branches
# =============================================================================

echo "Creating branch: null [orphan]"
$GIT worktree add -b null --orphan "$ROOT_DIR/null" >/dev/null
git -C "$ROOT_DIR/null" commit --allow-empty -m "chore: null branch — duplication source" >/dev/null 2>&1

create_orphan "main" "# $PROJECT_NAME" ""

# =============================================================================
# Phase 2 — Planning Branches
# =============================================================================

create_orphan "01_rough-plan" \
    "# 01 Rough Plan

Brainstorming space for:
- Rough project idea
- MVP scope
- Future releases

Agent: Use interview-style Q&A to gather context from developer."

create_orphan "02_context" \
    "# 02 Context

Precise scope setting. Uses resources from:
- https://github.com/flowtress-docker/context

Gathers: project context, relevant skills, interview Q&A results.
Demarcates into plans and specs. No implementation." \
    "CONTEXT.md"

cat > "$ROOT_DIR/02_context/CONTEXT.md" << 'EOF'
# Project Context

## Interview Q&A

<!-- Agent: document interview results here -->

## Skills Required

<!-- Agent: list skills gathered from flowtress-docker/context -->

## Decisions

<!-- Key decisions made during context gathering -->

## Open Questions

<!-- Unresolved items for next session -->
EOF
git -C "$ROOT_DIR/02_context" add CONTEXT.md >/dev/null 2>&1
git -C "$ROOT_DIR/02_context" commit --amend --no-edit >/dev/null 2>&1

create_orphan "02_plan" \
    "# 02 Plan

Detailed MVP plan. Content fed from 02_context.

Subfolders:
- plan/ — demarcated plans per feature area (.md + .toml + agent-optimized formats)" \
    "plan/"

# =============================================================================
# Phase 3 — Standards
# =============================================================================

create_orphan "ui/impeccable" \
    "# UI Standards — Impeccable

Source: https://github.com/pbakaus/impeccable

Anti-patterns and standards for all UI:
- Typography
- Color schemes
- Layout principles
- Accessibility (WCAG)
- Responsive design

Used by: all impl/front-end_* branches."

# =============================================================================
# Phase 4 — Spec Branches (9 orphans)
# =============================================================================

SPEC_README='# Spec: SPECNAME

Specification for SPECNAME.

Contents:
- Code behavior definition
- Branding requirements
- UX copy
- Anti-patterns to avoid
- Visualizations (if needed for approval)

No implementation code on this branch.'

for spec_branch in spec/front-end_tech-stack spec/back-end_tech-stack \
                   spec/front-end_typography spec/front-end_color-scheme \
                   spec/front-end_navbar spec/front-end_footer \
                   spec/front-end_app-shell spec/front-end_hero \
                   spec/front-end_homepage; do
    spec_name="${spec_branch##*/}"
    spec_dir="$ROOT_DIR/$spec_branch"

    $GIT worktree add -b "$spec_branch" --orphan "$spec_dir" >/dev/null
    printf '%s\n' "${SPEC_README//SPECNAME/$spec_name}" > "$spec_dir/README.md"
    mkdir -p "$spec_dir/spec"
    touch "$spec_dir/spec/.gitkeep"
    git -C "$spec_dir" add -A >/dev/null 2>&1
    git -C "$spec_dir" commit -m "chore: $spec_branch — specification" >/dev/null 2>&1
    echo "Creating branch: $spec_branch [orphan]"
done

# =============================================================================
# Phase 5 — Implementation Branches
# =============================================================================

# Front-end tech-stack (orphan)
create_orphan "impl/front-end_tech-stack" \
    "# Front-End Tech Stack

Boilerplate to confirm dependencies work together.
- Runs on localhost
- Agents should NOT customize this branch
- Resolve dependency conflicts here before implementation begins" \
    ".gitignore src/"

cat > "$ROOT_DIR/impl/front-end_tech-stack/.gitignore" << 'EOF'
# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-*

# Dependencies
node_modules/
__pycache__/
*.pyc
EOF
git -C "$ROOT_DIR/impl/front-end_tech-stack" add .gitignore >/dev/null 2>&1
git -C "$ROOT_DIR/impl/front-end_tech-stack" commit --amend --no-edit >/dev/null 2>&1

# Front-end fork chain (7 forks)
for fork_pair in \
    "impl/front-end_typography:impl/front-end_tech-stack" \
    "impl/front-end_color-scheme:impl/front-end_typography" \
    "impl/front-end_navbar:impl/front-end_color-scheme" \
    "impl/front-end_footer:impl/front-end_navbar" \
    "impl/front-end_app-shell:impl/front-end_footer" \
    "impl/front-end_hero:impl/front-end_app-shell" \
    "impl/front-end_homepage:impl/front-end_app-shell"; do
    branch="${fork_pair%%:*}"
    parent="${fork_pair##*:}"
    create_fork "$branch" "$parent"
done

# Back-end (3 orphans)
create_orphan "impl/back-end_tech-stack" \
    "# Back-End Tech Stack

Boilerplate to confirm runtime and dependencies work.
- Agents should NOT customize this branch
- Resolve dependency conflicts here before implementation begins" \
    ".gitignore src/"

cat > "$ROOT_DIR/impl/back-end_tech-stack/.gitignore" << 'EOF'
# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Dependencies
node_modules/
__pycache__/
*.pyc
*.env
EOF
git -C "$ROOT_DIR/impl/back-end_tech-stack" add .gitignore >/dev/null 2>&1
git -C "$ROOT_DIR/impl/back-end_tech-stack" commit --amend --no-edit >/dev/null 2>&1

create_orphan "impl/back-end_api" \
    "# Back-End: API

Standalone implementation. Info from spec/back-end_tech-stack." \
    "src/"

create_orphan "impl/back-end_db" \
    "# Back-End: DB

Standalone implementation. Info from spec/back-end_tech-stack." \
    "src/"

# =============================================================================
# Phase 6 — QA Branches
# =============================================================================

create_fork "testing/front-end_navbar" "impl/front-end_navbar"

create_orphan "staging/v1" \
    "# Staging: v1

Integration staging. Merges impl/ branches for testing before deployment."

create_fork "bug-fixes/front-end_navbar-nav-fix" "impl/front-end_navbar"

create_orphan "deployment/v1" \
    "# Deployment: v1

Production-ready code. Merged from bug-fixes/ + staging/."

create_orphan "deployment/v2" \
    "# Deployment: v2

Production-ready code."

# =============================================================================
# Summary
# =============================================================================

echo ""
echo "Scaffolded ${PROJECT_NAME}_root with 31 branches."
echo ""
echo "Next: cd ${PROJECT_NAME}_root && git --git-dir=.bare worktree list"

exit 0
